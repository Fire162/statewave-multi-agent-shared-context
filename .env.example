# ── LLM provider (via LiteLLM) ────────────────────────────────────────
# API key for your LLM provider. The default model below is Groq (free tier).
# Get a Groq key at https://console.groq.com/keys
LLM_API_KEY=your-llm-api-key-here

# LiteLLM model string, formatted as "<provider>/<model>". Defaults to Groq.
# Examples:
#   groq/llama-3.3-70b-versatile          (default; free tier)
#   openai/gpt-4o-mini                    (requires an OpenAI key)
#   anthropic/claude-3-5-haiku-20241022   (requires an Anthropic key)
#   ollama/llama3                         (local Ollama instance, no key)
# LLM_MODEL=groq/llama-3.3-70b-versatile

# ── Statewave (self-hosted, local by default) ─────────────────────────
# Base URL of your local Statewave server (npx @statewavedev/statewave).
STATEWAVE_BASE_URL=http://localhost:8100

# Optional: API key, only if your Statewave instance requires auth.
# STATEWAVE_API_KEY=your-key-here
